---
import Shield from "@/components/icons/Shield.astro";
import Code from "@/components/icons/Code.astro";
import type { Translation } from "@/i18n/types";

interface Props {
  language: Translation;
}

const { language } = Astro.props;
const { skillsSubtitle, skillsFilters, skillsCategories } = language;

---

<div class="space-y-8">
  {skillsSubtitle && (
    <p class="max-w-2xl text-base text-gray-600 md:text-lg dark:text-gray-400">
      {skillsSubtitle}
    </p>
  )}

  <!-- Selector segmentado de habilidades -->
  <div class="flex justify-center">
    <div
      class="inline-flex items-center rounded-full border border-indigo-500/20 bg-slate-100/90 p-1.5 backdrop-blur-xs dark:border-slate-800 dark:bg-slate-900/90"
    >
      <button
        type="button"
        data-filter="cybersecurity"
        class="skill-filter-btn inline-flex cursor-pointer items-center justify-center gap-2 rounded-full px-5 py-2 text-sm font-semibold transition-all duration-200 bg-indigo-600 text-white shadow-xs dark:bg-yellow-400 dark:text-slate-950 focus:outline-none"
      >
        <Shield class="size-4 shrink-0" />
        {skillsFilters.cybersecurity}
      </button>
      <button
        type="button"
        data-filter="development"
        class="skill-filter-btn inline-flex cursor-pointer items-center justify-center gap-2 rounded-full px-5 py-2 text-sm font-medium transition-all duration-200 bg-transparent text-slate-600 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-yellow-400 focus:outline-none"
      >
        <Code class="size-4 shrink-0" />
        {skillsFilters.development}
      </button>
    </div>
  </div>

  <!-- Grid de tarjetas de habilidades -->
  <div id="skills-grid" class="grid grid-cols-1 gap-6 md:grid-cols-2">
    {
      skillsCategories?.map((category) => {
        const isHidden = category.type !== "cybersecurity";
        return (
          <div
            data-type={category.type}
            class={`skill-card group relative flex flex-col justify-between rounded-2xl border border-indigo-500/20 bg-white/60 p-6 shadow-xs backdrop-blur-xs transition-all duration-300 hover:-translate-y-1 hover:border-indigo-500/50 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/60 dark:hover:border-yellow-400/40 ${isHidden ? "hidden" : ""}`}
          >
            <div>
              <div class="mb-4 flex items-center gap-3">
                <div
                  class="flex size-11 items-center justify-center rounded-xl border border-indigo-500/20 bg-indigo-500/10 text-indigo-500 dark:border-yellow-400/20 dark:bg-yellow-400/10 dark:text-yellow-400"
                >
                  {category.iconName === "offensive" && (
                    <svg
                      class="size-6"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="12" r="10" />
                      <line x1="22" y1="12" x2="18" y2="12" />
                      <line x1="6" y1="12" x2="2" y2="12" />
                      <line x1="12" y1="6" x2="12" y2="2" />
                      <line x1="12" y1="22" x2="12" y2="18" />
                    </svg>
                  )}
                  {category.iconName === "defensive" && (
                    <svg
                      class="size-6"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
                      <path d="m9 12 2 2 4-4" />
                    </svg>
                  )}
                  {category.iconName === "forensics" && (
                    <svg
                      class="size-6"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="11" cy="11" r="8" />
                      <line x1="21" y1="21" x2="16.65" y2="16.65" />
                      <line x1="11" y1="8" x2="11" y2="14" />
                      <line x1="8" y1="11" x2="14" y2="11" />
                    </svg>
                  )}
                  {category.iconName === "systems" && (
                    <svg
                      class="size-6"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect width="20" height="8" x="2" y="2" rx="2" ry="2" />
                      <rect width="20" height="8" x="2" y="14" rx="2" ry="2" />
                      <line x1="6" x2="6.01" y1="6" y2="6" />
                      <line x1="6" x2="6.01" y1="18" y2="18" />
                    </svg>
                  )}
                  {category.iconName === "frontend" && (
                    <svg
                      class="size-6"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect width="20" height="14" x="2" y="3" rx="2" />
                      <line x1="8" x2="16" y1="21" y2="21" />
                      <line x1="12" x2="12" y1="17" y2="21" />
                    </svg>
                  )}
                  {category.iconName === "backend" && (
                    <svg
                      class="size-6"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="16 18 22 12 16 6" />
                      <polyline points="8 6 2 12 8 18" />
                    </svg>
                  )}
                  {category.iconName === "databases" && (
                    <svg
                      class="size-6"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <ellipse cx="12" cy="5" rx="9" ry="3" />
                      <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
                      <path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3" />
                    </svg>
                  )}
                  {category.iconName === "devops" && (
                    <svg
                      class="size-6"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
                    </svg>
                  )}
                </div>
                <h3 class="text-xl font-bold text-slate-900 dark:text-white">
                  {category.title}
                </h3>
              </div>
              <p class="mb-5 text-sm text-gray-600 dark:text-gray-400">
                {category.description}
              </p>
            </div>

            <ul class="flex flex-wrap gap-2 pt-3 border-t border-gray-200/60 dark:border-slate-800/80">
              {category.skills.map((skill) => (
                <li>
                  <span
                    class="inline-flex items-center rounded-lg border border-slate-200 bg-white/90 px-2.5 py-1 text-xs font-medium text-slate-700 shadow-2xs transition-all duration-200 hover:scale-105 hover:border-indigo-500 hover:text-indigo-600 dark:border-slate-700/80 dark:bg-slate-800/90 dark:text-slate-200 dark:hover:border-yellow-400 dark:hover:text-yellow-400"
                  >
                    {skill}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </div>
</div>

<script is:inline>
  const initSkillFilters = () => {
    const filterButtons = document.querySelectorAll(".skill-filter-btn");
    const skillCards = document.querySelectorAll(".skill-card");

    if (!filterButtons.length || !skillCards.length) return;

    const activeClasses = [
      "bg-indigo-600",
      "text-white",
      "shadow-xs",
      "dark:bg-yellow-400",
      "dark:text-slate-950",
      "font-semibold",
    ];

    const inactiveClasses = [
      "bg-transparent",
      "text-slate-600",
      "hover:text-indigo-600",
      "dark:text-slate-400",
      "dark:hover:text-yellow-400",
      "font-medium",
    ];

    filterButtons.forEach((btn) => {
      btn.onclick = () => {
        const filter = btn.getAttribute("data-filter");

        // Actualizar estilos del botón activo / inactivo
        filterButtons.forEach((b) => {
          if (b === btn) {
            b.classList.remove(...inactiveClasses);
            b.classList.add(...activeClasses);
          } else {
            b.classList.remove(...activeClasses);
            b.classList.add(...inactiveClasses);
          }
        });

        // Filtrar tarjetas
        skillCards.forEach((card) => {
          const cardType = card.getAttribute("data-type");
          if (cardType === filter) {
            card.classList.remove("hidden");
          } else {
            card.classList.add("hidden");
          }
        });
      };
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSkillFilters);
  } else {
    initSkillFilters();
  }
  document.addEventListener("astro:after-swap", initSkillFilters);
</script>
