---
import Shield from "@/components/icons/Shield.astro";
import Code from "@/components/icons/Code.astro";
import type { Translation } from "@/i18n/types";

interface Props {
  language: Translation;
}

const { language } = Astro.props;
const { skillsSubtitle, skillsFilters, skillsCategories } = language;

const CATEGORY_STYLES: Record<
  string,
  { iconBg: string; pillHover: string }
> = {
  offensive: {
    iconBg: "bg-rose-500/10 dark:bg-rose-400/10 text-rose-600 dark:text-rose-400 border-rose-500/20",
    pillHover: "hover:border-rose-400 dark:hover:border-rose-400/60 hover:text-rose-600 dark:hover:text-rose-300",
  },
  defensive: {
    iconBg: "bg-sky-500/10 dark:bg-sky-400/10 text-sky-600 dark:text-sky-400 border-sky-500/20",
    pillHover: "hover:border-sky-400 dark:hover:border-sky-400/60 hover:text-sky-600 dark:hover:text-sky-300",
  },
  forensics: {
    iconBg: "bg-amber-500/10 dark:bg-amber-400/10 text-amber-600 dark:text-amber-400 border-amber-500/20",
    pillHover: "hover:border-amber-400 dark:hover:border-amber-400/60 hover:text-amber-600 dark:hover:text-amber-300",
  },
  systems: {
    iconBg: "bg-emerald-500/10 dark:bg-emerald-400/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20",
    pillHover: "hover:border-emerald-400 dark:hover:border-emerald-400/60 hover:text-emerald-600 dark:hover:text-emerald-300",
  },
  frontend: {
    iconBg: "bg-purple-500/10 dark:bg-purple-400/10 text-purple-600 dark:text-purple-400 border-purple-500/20",
    pillHover: "hover:border-purple-400 dark:hover:border-purple-400/60 hover:text-purple-600 dark:hover:text-purple-300",
  },
  backend: {
    iconBg: "bg-indigo-500/10 dark:bg-indigo-400/10 text-indigo-600 dark:text-indigo-400 border-indigo-500/20",
    pillHover: "hover:border-indigo-400 dark:hover:border-indigo-400/60 hover:text-indigo-600 dark:hover:text-indigo-300",
  },
  databases: {
    iconBg: "bg-teal-500/10 dark:bg-teal-400/10 text-teal-600 dark:text-teal-400 border-teal-500/20",
    pillHover: "hover:border-teal-400 dark:hover:border-teal-400/60 hover:text-teal-600 dark:hover:text-teal-300",
  },
  devops: {
    iconBg: "bg-blue-500/10 dark:bg-blue-400/10 text-blue-600 dark:text-blue-400 border-blue-500/20",
    pillHover: "hover:border-blue-400 dark:hover:border-blue-400/60 hover:text-blue-600 dark:hover:text-blue-300",
  },
};
---

<div class="space-y-8">
  {skillsSubtitle && (
    <p class="max-w-2xl text-base text-gray-600 md:text-lg dark:text-gray-400">
      {skillsSubtitle}
    </p>
  )}

  <!-- Selector de filtros con estilo SocialPill -->
  <div class="flex flex-wrap items-center gap-3">
    <button
      type="button"
      data-filter="all"
      class="skill-filter-btn group inline-flex cursor-pointer items-center justify-center gap-2 rounded-full border border-indigo-500 bg-indigo-500 px-4 py-1 text-xs md:text-sm font-semibold text-white shadow-xs transition-colors duration-200 hover:border-indigo-500 hover:bg-indigo-500 hover:text-white focus:outline-none dark:border-yellow-200/90 dark:bg-yellow-200/90 dark:text-indigo-950 dark:hover:border-yellow-200/90 dark:hover:bg-yellow-200/90 dark:hover:text-indigo-950"
    >
      <svg
        class="size-4 shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect width="7" height="7" x="3" y="3" rx="1"></rect>
        <rect width="7" height="7" x="14" y="3" rx="1"></rect>
        <rect width="7" height="7" x="14" y="14" rx="1"></rect>
        <rect width="7" height="7" x="3" y="14" rx="1"></rect>
      </svg>
      {skillsFilters.all}
    </button>
    <button
      type="button"
      data-filter="cybersecurity"
      class="skill-filter-btn group inline-flex cursor-pointer items-center justify-center gap-2 rounded-full border border-indigo-500/40 bg-slate-100 px-4 py-1 text-xs md:text-sm font-medium text-slate-700 transition-colors duration-200 hover:border-indigo-500 hover:bg-indigo-500 hover:text-white focus:outline-none dark:border-yellow-200 dark:bg-transparent dark:text-slate-200 dark:hover:border-yellow-200/90 dark:hover:bg-yellow-200/90 dark:hover:text-indigo-950"
    >
      <Shield class="size-4 shrink-0" />
      {skillsFilters.cybersecurity}
    </button>
    <button
      type="button"
      data-filter="development"
      class="skill-filter-btn group inline-flex cursor-pointer items-center justify-center gap-2 rounded-full border border-indigo-500/40 bg-slate-100 px-4 py-1 text-xs md:text-sm font-medium text-slate-700 transition-colors duration-200 hover:border-indigo-500 hover:bg-indigo-500 hover:text-white focus:outline-none dark:border-yellow-200 dark:bg-transparent dark:text-slate-200 dark:hover:border-yellow-200/90 dark:hover:bg-yellow-200/90 dark:hover:text-indigo-950"
    >
      <Code class="size-4 shrink-0" />
      {skillsFilters.development}
    </button>
  </div>

  <!-- Grid de tarjetas de habilidades -->
  <div id="skills-grid" class="grid grid-cols-1 gap-6 md:grid-cols-2">
    {
      skillsCategories?.map((category) => {
        const style =
          CATEGORY_STYLES[category.iconName] || CATEGORY_STYLES.backend;
        return (
          <div
            data-type={category.type}
            class="skill-card group relative flex flex-col justify-between rounded-2xl border border-indigo-500/20 bg-white/60 p-6 shadow-xs backdrop-blur-xs transition-all duration-300 hover:-translate-y-1 hover:border-indigo-500/50 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/60 dark:hover:border-indigo-500/40"
          >
            <div>
              <div class="mb-4 flex items-center gap-3">
                <div
                  class={`flex size-11 items-center justify-center rounded-xl border ${style.iconBg}`}
                >
                  {category.iconName === "offensive" && (
                    <svg
                      class="size-6"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="12" r="10" />
                      <line x1="22" y1="12" x2="18" y2="12" />
                      <line x1="6" y1="12" x2="2" y2="12" />
                      <line x1="12" y1="6" x2="12" y2="2" />
                      <line x1="12" y1="22" x2="12" y2="18" />
                    </svg>
                  )}
                  {category.iconName === "defensive" && (
                    <svg
                      class="size-6"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
                      <path d="m9 12 2 2 4-4" />
                    </svg>
                  )}
                  {category.iconName === "forensics" && (
                    <svg
                      class="size-6"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="11" cy="11" r="8" />
                      <line x1="21" y1="21" x2="16.65" y2="16.65" />
                      <line x1="11" y1="8" x2="11" y2="14" />
                      <line x1="8" y1="11" x2="14" y2="11" />
                    </svg>
                  )}
                  {category.iconName === "systems" && (
                    <svg
                      class="size-6"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect width="20" height="8" x="2" y="2" rx="2" ry="2" />
                      <rect width="20" height="8" x="2" y="14" rx="2" ry="2" />
                      <line x1="6" x2="6.01" y1="6" y2="6" />
                      <line x1="6" x2="6.01" y1="18" y2="18" />
                    </svg>
                  )}
                  {category.iconName === "frontend" && (
                    <svg
                      class="size-6"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect width="20" height="14" x="2" y="3" rx="2" />
                      <line x1="8" x2="16" y1="21" y2="21" />
                      <line x1="12" x2="12" y1="17" y2="21" />
                    </svg>
                  )}
                  {category.iconName === "backend" && (
                    <svg
                      class="size-6"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="16 18 22 12 16 6" />
                      <polyline points="8 6 2 12 8 18" />
                    </svg>
                  )}
                  {category.iconName === "databases" && (
                    <svg
                      class="size-6"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <ellipse cx="12" cy="5" rx="9" ry="3" />
                      <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
                      <path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3" />
                    </svg>
                  )}
                  {category.iconName === "devops" && (
                    <svg
                      class="size-6"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
                    </svg>
                  )}
                </div>
                <h3 class="text-xl font-bold text-slate-900 dark:text-white">
                  {category.title}
                </h3>
              </div>
              <p class="mb-5 text-sm text-gray-600 dark:text-gray-400">
                {category.description}
              </p>
            </div>

            <ul class="flex flex-wrap gap-2 pt-3 border-t border-gray-200/60 dark:border-slate-800/80">
              {category.skills.map((skill) => (
                <li>
                  <span
                    class={`inline-flex items-center rounded-lg border border-slate-200 bg-white/90 px-2.5 py-1 text-xs font-medium text-slate-700 shadow-2xs transition-all duration-200 hover:scale-105 dark:border-slate-700/80 dark:bg-slate-800/90 dark:text-slate-200 ${style.pillHover}`}
                  >
                    {skill}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </div>
</div>

<script is:inline>
  const initSkillFilters = () => {
    const filterButtons = document.querySelectorAll(".skill-filter-btn");
    const skillCards = document.querySelectorAll(".skill-card");

    const activeClasses = [
      "border-indigo-500",
      "bg-indigo-500",
      "text-white",
      "dark:border-yellow-200/90",
      "dark:bg-yellow-200/90",
      "dark:text-indigo-950",
      "font-semibold",
      "shadow-xs",
    ];

    const inactiveClasses = [
      "border-indigo-500/40",
      "bg-slate-100",
      "text-slate-700",
      "dark:border-yellow-200",
      "dark:bg-transparent",
      "dark:text-slate-200",
      "font-medium",
    ];

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.getAttribute("data-filter");

        // Actualizar estilos del botón activo
        filterButtons.forEach((b) => {
          if (b === btn) {
            b.classList.remove(...inactiveClasses);
            b.classList.add(...activeClasses);
          } else {
            b.classList.remove(...activeClasses);
            b.classList.add(...inactiveClasses);
          }
        });

        // Filtrar tarjetas
        skillCards.forEach((card) => {
          const cardType = card.getAttribute("data-type");
          if (filter === "all" || cardType === filter) {
            card.classList.remove("hidden");
          } else {
            card.classList.add("hidden");
          }
        });
      });
    });
  };

  document.addEventListener("DOMContentLoaded", initSkillFilters);
  document.addEventListener("astro:after-swap", initSkillFilters);
</script>
