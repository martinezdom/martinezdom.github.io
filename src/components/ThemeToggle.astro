---
import SunIcon from "./icons/Sun.astro";
import MoonIcon from "./icons/Moon.astro";
import type { Translation } from "@/i18n/types";

interface Props {
  language: Translation;
  variant?: "header" | "side" | "footer";
  position?: "top" | "bottom";
}

const { language, variant = "footer" } = Astro.props;

const footerButtonClasses =
  "theme-toggle-btn theme-toggle-glitter glitter relative z-10 flex size-10 cursor-pointer items-center justify-center rounded-full border-2 border-indigo-500 bg-white/80 p-1 text-indigo-500 shadow-lg backdrop-blur-sm transition-all duration-300 hover:scale-110 hover:border-indigo-500 hover:bg-indigo-500 hover:text-white hover:shadow-indigo-500/50 active:scale-95 dark:border-yellow-500 dark:bg-slate-800/80 dark:text-yellow-400 dark:hover:border-yellow-500 dark:hover:bg-yellow-500 dark:hover:text-slate-900 dark:hover:shadow-yellow-500/50";

const headerButtonClasses =
  "theme-toggle-btn flex size-7 cursor-pointer items-center justify-center rounded-full text-slate-900 transition-all duration-200 hover:scale-110 hover:text-indigo-600 dark:text-white dark:hover:text-yellow-400 active:scale-95";

const sideButtonClasses =
  "theme-toggle-btn flex size-5 cursor-pointer items-center justify-center text-slate-500 transition-colors duration-200 hover:text-indigo-500 dark:text-slate-400 dark:hover:text-yellow-400 active:scale-95";
---

{
  variant === "header" && (
    <button
      type="button"
      aria-label={language.themes.selectorText}
      title={language.themes.selectorText}
      class={headerButtonClasses}
    >
      <span class="theme-icon-light hidden items-center justify-center">
        <SunIcon class="size-[20px]" />
      </span>
      <span class="theme-icon-dark hidden items-center justify-center">
        <MoonIcon class="size-[18px]" />
      </span>
    </button>
  )
}

{
  variant === "side" && (
    <div class="group relative flex items-center justify-center p-1 text-xs transition-transform duration-200 hover:scale-125 cursor-pointer">
      {/* Tooltip hacia la izquierda */}
      <span
        class="pointer-events-none absolute right-full mr-3.5 translate-x-2 whitespace-nowrap rounded-lg border border-indigo-500/30 bg-slate-900/90 px-2.5 py-1 text-xs font-semibold text-white opacity-0 shadow-xl backdrop-blur-md transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100 dark:border-yellow-200/40 dark:bg-slate-100 dark:text-slate-950"
      >
        {language.themes.selectorText}
      </span>

      <button
        type="button"
        aria-label={language.themes.selectorText}
        title={language.themes.selectorText}
        class={sideButtonClasses}
      >
        <span class="theme-icon-light hidden items-center justify-center">
          <SunIcon class="size-[19px]" />
        </span>
        <span class="theme-icon-dark hidden items-center justify-center">
          <MoonIcon class="size-[17px]" />
        </span>
      </button>
    </div>
  )
}

{
  variant === "footer" && (
    <button
      type="button"
      aria-label={language.themes.selectorText}
      title={language.themes.selectorText}
      class={footerButtonClasses}
    >
      <span class="theme-icon-light hidden items-center justify-center">
        <SunIcon class="size-[22px]" />
      </span>
      <span class="theme-icon-dark hidden items-center justify-center">
        <MoonIcon class="size-5" />
      </span>
    </button>
  )
}

<script is:inline>
  const initThemeToggles = () => {
    const isDark = () => document.documentElement.classList.contains("dark");

    const updateAllIcons = () => {
      const dark = isDark();
      document.querySelectorAll(".theme-toggle-btn").forEach((btn) => {
        const lightIcon = btn.querySelector(".theme-icon-light");
        const darkIcon = btn.querySelector(".theme-icon-dark");

        if (lightIcon && darkIcon) {
          if (dark) {
            lightIcon.classList.add("hidden");
            lightIcon.classList.remove("flex");
            darkIcon.classList.remove("hidden");
            darkIcon.classList.add("flex");
          } else {
            darkIcon.classList.add("hidden");
            darkIcon.classList.remove("flex");
            lightIcon.classList.remove("hidden");
            lightIcon.classList.add("flex");
          }
        }
      });
    };

    const toggleTheme = () => {
      const currentDark = isDark();
      const nextDark = !currentDark;
      const nextTheme = nextDark ? "dark" : "light";

      document.documentElement.classList.toggle("dark", nextDark);
      localStorage.setItem("theme", nextTheme);
      updateAllIcons();
    };

    document.querySelectorAll(".theme-toggle-btn").forEach((btn) => {
      if (btn.dataset.themeBound) return;
      btn.dataset.themeBound = "true";
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        toggleTheme();
      });
    });

    updateAllIcons();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initThemeToggles);
  } else {
    initThemeToggles();
  }
  document.addEventListener("astro:after-swap", initThemeToggles);

  // Sincronizar en caso de cambio de tema del sistema operativo
  if (!window.__themeMediaListenerAdded) {
    window.__themeMediaListenerAdded = true;
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
      if (!localStorage.getItem("theme")) {
        document.documentElement.classList.toggle("dark", e.matches);
        const isDark = e.matches;
        document.querySelectorAll(".theme-toggle-btn").forEach((btn) => {
          const lightIcon = btn.querySelector(".theme-icon-light");
          const darkIcon = btn.querySelector(".theme-icon-dark");
          if (lightIcon && darkIcon) {
            lightIcon.classList.toggle("hidden", isDark);
            lightIcon.classList.toggle("flex", !isDark);
            darkIcon.classList.toggle("hidden", !isDark);
            darkIcon.classList.toggle("flex", isDark);
          }
        });
      }
    });
  }
</script>
