---
import Code from "./icons/Code.astro";
import TitleSection from "./TitleSection.astro";
import Briefcase from "./icons/Briefcase.astro";
import System from "./icons/System.astro";
import SocialPill from "./SocialPill.astro";
import Mail from "./icons/Mail.astro";
import SectionContainer from "./SectionContainer.astro";

const { language } = Astro.props;
const data = language.servicesPage;
const contactEmail = "mailto:tartanasdev@gmail.com";
const processTitle =
  language.prefix === "en"
    ? "Work Process"
    : language.prefix === "va"
      ? "Procés de treball"
      : "Proceso de trabajo";
const additionalTitle =
  language.prefix === "en"
    ? "Additional Services"
    : language.prefix === "va"
      ? "Serveis Addicionals"
      : "Servicios Adicionales";
---

<SectionContainer id="servicios" class="pt-32 md:pt-40">
  <div class="flex flex-col gap-20">
    <header class="flex flex-col items-center justify-center gap-6 text-center">
      <h1
        class="text-4xl font-extrabold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
      >
        {data.hero.title}
      </h1>
      <p
        class="max-w-2xl text-lg text-pretty text-slate-600 md:text-xl dark:text-slate-300"
      >
        {data.hero.subtitle}
      </p>
    </header>

    <section>
      <TitleSection>
        <Code class="size-8 text-indigo-500 dark:text-yellow-200/90" />
        {data.featuredService.title}
      </TitleSection>
      <div
        class="relative mt-6 flex flex-col justify-between gap-8 rounded-2xl border border-indigo-500/40 bg-indigo-500/10 p-6 shadow-sm transition-all hover:shadow-md md:flex-row md:items-center md:p-10 dark:border-white/10 dark:bg-slate-900/50"
      >
        <ul class="flex flex-col gap-y-3 text-slate-700 dark:text-slate-300">
          {
            data.featuredService.features.map((feature: string) => (
              <li class="flex items-start gap-x-3">
                <span class="mt-1 flex h-4 w-4 items-center justify-center rounded-full bg-indigo-100 text-xs font-bold text-indigo-500 dark:bg-yellow-200/20 dark:text-yellow-200/90">
                  ✓
                </span>
                <span>{feature}</span>
              </li>
            ))
          }
        </ul>
        <div
          class="flex flex-col items-center justify-center rounded-xl bg-indigo-500/10 p-6 shadow-sm ring-1 ring-indigo-500/20 md:min-w-[200px] dark:bg-slate-900/80 dark:ring-white/10"
        >
          <span
            class="text-sm font-medium tracking-wider text-slate-500 uppercase dark:text-slate-400"
            >Precio único</span
          >
          <span
            class="mt-2 text-4xl font-bold text-indigo-500 dark:text-yellow-200/90"
          >
            {data.featuredService.price}
          </span>
        </div>
      </div>
    </section>

    <section>
      <TitleSection>
        <Briefcase class="size-8 text-indigo-500 dark:text-yellow-200/90" />
        {additionalTitle}
      </TitleSection>

      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
        <article
          class="group flex flex-col gap-y-3 rounded-2xl border border-indigo-500/40 bg-indigo-500/10 p-6 transition-all hover:-translate-y-1 hover:shadow-md dark:border-white/10 dark:bg-slate-900/50"
        >
          <h3 class="text-xl font-bold text-gray-800 dark:text-white">
            {data.additionalServices.audit.title}
          </h3>
          <span
            class="inline-flex w-max rounded-full bg-indigo-50 px-2.5 py-0.5 text-sm font-semibold text-indigo-600 dark:bg-yellow-200/10 dark:text-yellow-200/90"
          >
            {data.additionalServices.audit.price}
          </span>
          <p class="mt-2 text-slate-600 dark:text-slate-400">
            {data.additionalServices.audit.description}
          </p>
        </article>

        <article
          class="group flex flex-col gap-y-3 rounded-2xl border border-indigo-500/40 bg-indigo-500/10 p-6 transition-all hover:-translate-y-1 hover:shadow-md dark:border-white/10 dark:bg-slate-900/50"
        >
          <h3 class="text-xl font-bold text-gray-800 dark:text-white">
            {data.additionalServices.customDev.title}
          </h3>
          <span
            class="inline-flex w-max rounded-full bg-indigo-50 px-2.5 py-0.5 text-sm font-semibold text-indigo-600 dark:bg-yellow-200/10 dark:text-yellow-200/90"
          >
            {data.additionalServices.customDev.price}
          </span>
          <p class="mt-2 text-slate-600 dark:text-slate-400">
            {data.additionalServices.customDev.description}
          </p>
        </article>
      </div>
    </section>

    <section
      class="mt-10 flex flex-col items-center justify-center gap-6 rounded-3xl border border-indigo-500/40 bg-indigo-500/10 p-10 text-center dark:border-white/10 dark:bg-slate-900/50"
    >
      <h2 class="text-2xl font-bold text-gray-800 dark:text-white">
        {data.finalCta.supportText}
      </h2>
      <a
        href={contactEmail}
        class="inline-flex items-center justify-center gap-2 rounded-full bg-indigo-500 px-8 py-4 text-lg font-semibold text-white transition hover:scale-105 hover:bg-indigo-600 dark:bg-yellow-200/90 dark:text-slate-900 dark:hover:bg-yellow-200"
      >
        <Mail class="size-5" />
        {data.finalCta.buttonText}
      </a>
    </section>
  </div>
</SectionContainer>
