---
const { language } = Astro.props;
import SocialPill from "./SocialPill.astro";
import LinkedInIcon from "./icons/LinkedIn.astro";
import MailIcon from "./icons/Mail.astro";
import DocumentIcon from "./icons/Document.astro";
import GithubIcon from "./icons/Github.astro";
import Arrow from "./icons/Arrow.astro";
import Badge from "./Badge.astro";

const langPrefix = language.prefix || "es";
const cvFiles: Record<string, { dev: string; cyber: string }> = {
  es: {
    dev: "/cv/CV-Desarrollo-ES.pdf",
    cyber: "/cv/CV-Ciberseguridad-ES.pdf",
  },
  en: {
    dev: "/cv/CV-Development-EN.pdf",
    cyber: "/cv/CV-Cybersecurity-EN.pdf",
  },
  va: {
    dev: "/cv/CV-Desenvolupament-VA.pdf",
    cyber: "/cv/CV-Ciberseguretat-VA.pdf",
  },
};

const currentCv = cvFiles[langPrefix] || cvFiles.es;
---

<div
  class="grid grid-cols-1 items-center gap-8 pb-8 md:grid-cols-3 md:items-start"
>
  <div
    class="flex flex-col items-center gap-5 text-center md:col-span-2 md:items-start md:text-left"
  >
    <div class="flex flex-wrap items-center gap-4 md:justify-start">
      <a
        href="https://linkedin.com/in/martinezdom"
        target="_blank"
        rel="noopener"
        class="flex items-center transition md:justify-center md:hover:scale-105"
      >
        <Badge>
          <span class="mr-1.5 flex h-2 w-2 items-center justify-center">
            <span
              class="absolute inline-flex h-2 w-2 animate-ping rounded-full bg-indigo-400 opacity-75 dark:bg-yellow-200/90"
            ></span>
            <span
              class="relative inline-flex h-2 w-2 rounded-full bg-indigo-500 dark:bg-yellow-200/90"
            ></span>
          </span>
          {language.heroBadge}
        </Badge>
      </a>
    </div>
    <h1
      class="flex flex-col gap-2 text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl md:block md:gap-0 dark:text-white"
    >
      Miguel Ángel Martínez
    </h1>
    <p
      class="text-base leading-relaxed text-slate-700 md:text-xl dark:text-slate-300"
      set:html={language.heroDescription}
    />
    <nav
      class="grid w-full max-w-sm grid-cols-2 gap-4 text-xs font-medium md:max-w-none md:grid-cols-4 md:text-sm"
    >
      <SocialPill href="https://www.linkedin.com/in/martinezdom/">
        <LinkedInIcon class="size-4" />
        LinkedIn
      </SocialPill>
      <SocialPill href="https://github.com/martinezdom">
        <GithubIcon class="size-4" />
        GitHub
      </SocialPill>
      
      <!-- Selector desplegable de CVs -->
      <div class="relative w-full">
        <button
          id="cv-dropdown-btn"
          type="button"
          aria-expanded="false"
          aria-haspopup="menu"
          class="group inline-flex w-full cursor-pointer items-center justify-center gap-1.5 rounded-full border border-indigo-500/40 bg-slate-100 px-3 py-1 text-slate-700 transition-colors duration-200 hover:border-indigo-500 hover:bg-indigo-500 hover:text-white focus:outline-none dark:border-yellow-200 dark:bg-transparent dark:text-slate-200 dark:hover:border-yellow-200/90 dark:hover:bg-yellow-200/90 dark:hover:text-indigo-950"
        >
          <DocumentIcon class="size-4" />
          <span>{language.curriculum}</span>
          <Arrow class="h-3 w-3 transition-transform duration-200" id="cv-arrow" />
        </button>

        <div
          id="cv-menu"
          class="absolute left-1/2 z-10 mt-2 hidden w-max -translate-x-1/2"
          role="menu"
        >
          <div
            class="min-w-[180px] rounded-md border border-indigo-500/40 bg-white py-1 shadow-lg dark:bg-slate-900"
          >
            <a
              href={currentCv.dev}
              target="_blank"
              rel="noopener noreferrer"
              class="block px-4 py-2 text-center text-sm text-slate-900 transition-colors duration-150 hover:bg-indigo-50 hover:text-indigo-600 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-yellow-400"
              role="menuitem"
            >
              {language.curriculumDev}
            </a>
            <a
              href={currentCv.cyber}
              target="_blank"
              rel="noopener noreferrer"
              class="block px-4 py-2 text-center text-sm text-slate-900 transition-colors duration-150 hover:bg-indigo-50 hover:text-indigo-600 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-yellow-400"
              role="menuitem"
            >
              {language.curriculumCyber}
            </a>
          </div>
        </div>
      </div>

      <SocialPill href="mailto:tartanasdev@gmail.com">
        <MailIcon class="size-4" />
        {language.contactMe}
      </SocialPill>
    </nav>
  </div>
  <div class="order-first flex justify-center md:order-none md:justify-end">
    <a
      href="https://github.com/martinezdom"
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        class="glitter size-40 rounded-full object-cover transition duration-500 hover:scale-105 md:h-auto md:w-48 md:rounded-2xl lg:w-56"
        src="/hero_picture.webp"
        alt="Miguel Ángel"
      />
    </a>
  </div>
</div>

<script is:inline>
  const initCvDropdown = () => {
    const cvBtn = document.getElementById("cv-dropdown-btn");
    const cvMenu = document.getElementById("cv-menu");
    const cvArrow = document.getElementById("cv-arrow");

    if (!cvBtn || !cvMenu) return;

    const toggleMenu = () => {
      const isOpen = cvBtn.getAttribute("aria-expanded") === "true";
      cvMenu.classList.toggle("hidden", isOpen);
      cvMenu.classList.toggle("flex", !isOpen);
      cvBtn.setAttribute("aria-expanded", (!isOpen).toString());
      if (cvArrow) {
        cvArrow.style.transform = isOpen ? "rotate(0deg)" : "rotate(180deg)";
      }
    };

    const closeMenu = () => {
      cvMenu.classList.add("hidden");
      cvMenu.classList.remove("flex");
      cvBtn.setAttribute("aria-expanded", "false");
      if (cvArrow) {
        cvArrow.style.transform = "rotate(0deg)";
      }
    };

    cvBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    document.addEventListener("click", (e) => {
      if (!cvBtn.contains(e.target) && !cvMenu.contains(e.target)) {
        closeMenu();
      }
    });
  };

  document.addEventListener("DOMContentLoaded", initCvDropdown);
  document.addEventListener("astro:after-swap", initCvDropdown);
</script>
